# 设备选择（lede/coolsnowwolf 推荐）
CONFIG_TARGET_ipq807x=y
CONFIG_TARGET_ipq807x_generic=y
CONFIG_TARGET_ipq807x_generic_DEVICE_xiaomi_ax3600=y

# 官方 OpenWrt 设备选择（如用官方源码请取消注释，注释掉上面三行）
# CONFIG_TARGET_ipq807x=y
# CONFIG_TARGET_ipq807x_xiaomi_ax3600=y

CONFIG_TARGET_IMAGES_GZIP=y

# 基础软件包
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# 常用插件
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-qwrt=y

# 语言和区域设置
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# 其它可选配置
CONFIG_DEVEL=y
CONFIG_BUILD_USER="github"
CONFIG_BUILD_HOST="actions"

# ...可根据实际需求添加/删除软件包...
